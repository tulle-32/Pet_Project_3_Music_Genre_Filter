{
  "manifest_version": 3,
  "name": "Music Genre Filter — выгрузка ВК",
  "version": "1.0.0",
  "description": "Собирает список треков со страницы ВК прямо внутри твоей открытой вкладки и отдаёт файл JSON для 'music import file' (см. docs/DECISIONS.md, Р-016).",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": ["*://vk.com/*", "*://vk.ru/*", "*://*.vk.com/*", "*://*.vk.ru/*"],
      "js": ["network-interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://vk.com/*", "*://vk.ru/*", "*://*.vk.com/*", "*://*.vk.ru/*"],
      "js": ["content-ui.js"],
      "run_at": "document_idle"
    }
  ]
}
