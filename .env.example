# =============================================================================
# ОБРАЗЕЦ настроек. Скопируй в .env и заполни значения.
#   PowerShell:  Copy-Item .env.example .env
#   Git Bash:    cp .env.example .env
#
# Файл .env в git НЕ попадает — он перечислен в .gitignore.
# Этот файл (.env.example) в git попадает и служит документацией:
# по нему видно, какие настройки существуют, но не видно значений.
#
# Из этого файла читают ДВОЕ: приложение на Go и docker compose.
# Поэтому настройки базы здесь одни и те же для обоих — не получится
# случайно поднять базу с одним паролем, а подключаться с другим.
# =============================================================================

# ---------- База данных PostgreSQL ----------
# HOST=localhost, потому что база живёт в контейнере, а порт проброшен
# на твой компьютер. Для приложения она выглядит как локальная.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=music
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=music_genre_filter
# Сколько одновременных соединений держать в пуле.
# Для разработки хватает 10 с большим запасом.
POSTGRES_MAX_CONNS=10

# ---------- HTTP-сервер ----------
# Пустой хост слева от двоеточия = слушать на всех сетевых интерфейсах.
HTTP_ADDR=:8080
# Сколько ждать завершения текущих запросов при остановке сервиса.
SHUTDOWN_TIMEOUT=10s

# ---------- Журнал ----------
# debug | info | warn | error
LOG_LEVEL=info

# ---------- Last.fm (v0.7.0) ----------
# Бесплатный ключ выдаётся мгновенно: https://www.last.fm/api/account/create
# Единственный провайдер жанров в проекте — MusicBrainz и Deezer обсуждались,
# но признаны лишними для решения исходной задачи (Р-018 в docs/DECISIONS.md).
LASTFM_API_KEY=
# Секрет выдаётся вместе с ключом на той же странице. Сейчас код его нигде
# не использует для подписи запросов (artist.gettoptags — это read-only
# метод, подпись не нужна) — хранится и читается на будущее, если появится
# метод API, которому подпись обязательна. Можно оставить пустым.
LASTFM_SHARED_SECRET=

# ---------- Источник ВКонтакте (v0.6.0) ----------
# Начиная с Р-016 (docs/DECISIONS.md) программе не нужна ни одна настройка
# для ВК — здесь раньше были VK_SESSION_COOKIE, VK_DEBUG_PORT,
# VK_REQUEST_DELAY_SECONDS, VK_DAILY_FETCH_LIMIT (и ещё раньше
# VK_CHROME_PATH, VK_HEADLESS). Все они относились к механике, которой
# больше нет: программа сама не открывает и не изображает браузер.
#
# Вместо этого треки из ВК выгружает расширение браузера (extension/,
# инструкция в extension/README.md) — оно ставится в твой обычный,
# уже залогиненный браузер, само собирает список и отдаёт файл JSON.
# Дальше это обычный файловый импорт:
#   music import file tracks.json --library "Имя"
# см. docs/VK_ACCESS.md.
