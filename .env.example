# =============================================================================
# ОБРАЗЕЦ настроек. Скопируй в .env и заполни значения.
#   Linux/macOS:  cp .env.example .env
#   Windows:      copy .env.example .env
#
# Файл .env в git НЕ попадает — он перечислен в .gitignore.
# Этот файл (.env.example) в git попадает и служит документацией:
# по нему видно, какие настройки существуют, но не видно значений.
# =============================================================================

# ---------- База данных PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=music
POSTGRES_PASSWORD=change_me
POSTGRES_DB=music_genre_filter

# ---------- HTTP-сервер ----------
# Адрес, на котором слушает приложение. Пустой хост = слушать на всех интерфейсах.
HTTP_ADDR=:8080

# ---------- Last.fm (появится в v0.7.0) ----------
# Бесплатный ключ выдаётся мгновенно: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# ---------- MusicBrainz (появится в v0.8.0) ----------
# Сервис ТРЕБУЕТ осмысленный User-Agent с контактом для связи.
# Без него или при превышении лимита он отдаёт 503 на все запросы.
# Формат: НазваниеПриложения/версия ( контакт )
MUSICBRAINZ_USER_AGENT=MusicGenreFilter/0.1 ( your-email@example.com )

# ---------- Источник ВКонтакте (появится в v0.6.0) ----------
# Токен аккаунта, от имени которого приложение читает страницы с музыкой.
# НИКОГДА не коммитить. Подробности и риски: docs/VK_ACCESS.md
VK_TOKEN=
# Пауза между запросами к ВК в секундах. Ниже 2 не опускать:
# это то, что отличает "человек листает страницу" от "бот долбит сервер".
VK_REQUEST_DELAY_SECONDS=2
# Предохранитель: сколько страниц можно выкачать за сутки.
VK_DAILY_FETCH_LIMIT=20
